// Example ES|QL queries for NetBird peer and audit data.
// Paste into Kibana → Discover → ES|QL. Set the time picker to the window
// you care about.

// --- Peer state ---

// Currently connected peers
FROM logs-netbird.peer-*
| WHERE netbird.connected == true
| KEEP @timestamp, host.name, host.ip, netbird.peer_id, netbird.user_id, netbird.last_seen
| SORT @timestamp DESC
| LIMIT 200

// Peer connection history (bronze data stream)
FROM logs-netbird.peer-*
| WHERE host.name == "laptop.local"
| KEEP @timestamp, netbird.connected, netbird.last_seen, source.ip
| SORT @timestamp DESC
| LIMIT 500

// --- Audit events ---

// Recent audit activity
FROM logs-netbird.audit
| KEEP @timestamp, event.action, event.category, event.type, user.name, user.email, netbird.target_id
| SORT @timestamp DESC
| LIMIT 200

// Failed or denied actions
FROM logs-netbird.audit
| WHERE event.outcome != "success"
| KEEP @timestamp, event.action, user.name, user.email
| SORT @timestamp DESC
| LIMIT 200

// --- LOOKUP JOIN example ---
// LOOKUP JOIN only accepts netbird-peer-lookup (index.mode: lookup).
// One public IP can belong to more than one peer; those events repeat once
// per peer. netbird-api index rebuilds the lookup index with each full peer pull.

// Example: enrich another log source with NetBird peer data by source.ip
// FROM logs-other.log-*
// | WHERE source.ip IS NOT NULL
// | LOOKUP JOIN netbird-peer-lookup ON source.ip
// | WHERE netbird.peer_id IS NOT NULL
// | KEEP @timestamp, source.ip, netbird.peer_id, host.hostname, netbird.dns_label, netbird.connected, netbird.last_seen
// | SORT @timestamp DESC
// | LIMIT 200
