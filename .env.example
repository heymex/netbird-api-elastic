# Self-hosted NetBird dashboard origin. The client calls <origin>/api.
# Use the same hostname you open in the browser. Do not commit the real value.
NETBIRD_URL=https://vpn.example.edu
# Personal access token (service user). Header is "Authorization: Token <value>".
NETBIRD_TOKEN=
NETBIRD_VERIFY_TLS=true
NETBIRD_TIMEOUT=30

# Elasticsearch 9.x. Peer pulls append to bronze and replace the current snapshot.
# Audit events are inserted by event id, so a later pull does not duplicate them.
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
# ELASTIC_USER=
# ELASTIC_PASSWORD=
ELASTIC_VERIFY_TLS=true
ELASTIC_PEER_BRONZE_INDEX=logs-netbird.peer-default
ELASTIC_PEER_CURRENT_INDEX=netbird-peer-current
ELASTIC_PEER_LOOKUP_INDEX=netbird-peer-lookup
ELASTIC_AUDIT_INDEX=logs-netbird.audit
